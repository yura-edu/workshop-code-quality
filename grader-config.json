{
  "schemaVersion": "1.0",
  "templateSlug": "code-quality",
  "evaluationBlocks": [
    {
      "blockId": "auto",
      "evaluationType": "automated_pipeline",
      "metrics": [
        {
          "metricKey": "cyclomatic_complexity",
          "worker": "MetricsWorker",
          "weight": 35,
          "threshold": 15,
          "config": {
            "tool": "complexity-report",
            "maxAllowed": 15,
            "targetFiles": ["src/**/*.js"]
          }
        },
        {
          "metricKey": "code_duplication",
          "worker": "MetricsWorker",
          "weight": 35,
          "threshold": 0.05,
          "config": {
            "tool": "jscpd",
            "minTokens": 50,
            "targetFiles": ["src/**/*.js"]
          }
        },
        {
          "metricKey": "lint_violations",
          "worker": "MetricsWorker",
          "weight": 30,
          "threshold": 0.0,
          "config": {
            "tool": "eslint",
            "targetFiles": ["src/**/*.js"]
          }
        }
      ]
    }
  ]
}
